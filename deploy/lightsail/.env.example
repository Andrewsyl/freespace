# Copy to `.env` on the Lightsail box and fill in. NEVER commit the real .env.
# Secret values come from Secrets Manager: freespace/api-iHluTi

# --- Image source (ECR) ---
ECR_REGISTRY=530726524685.dkr.ecr.eu-west-1.amazonaws.com
# Pin to the tags currently in prod (git SHAs). Bump on each deploy.
# `redeploy.sh` will auto-fill API_TAG from the current git commit on the box.
API_TAG=92f168ad1a692f4dd66b29b8980975311036934a
WEB_TAG=56b589edd97524e033c647f3386663097f4bc341

# --- API secrets (from freespace/api-iHluTi) ---
DATABASE_URL=postgres://USER:PASS@freespace-db.cv48ycesawhx.eu-west-1.rds.amazonaws.com:5432/DBNAME
JWT_SECRET=

# --- Stripe (mode switch) ---
# Fill in BOTH key pairs below once, then flip STRIPE_MODE to go live/back to
# test — no need to copy keys around. STRIPE_MODE selects which pair the app
# uses (it gets copied into STRIPE_SECRET_KEY/STRIPE_WEBHOOK_SECRET at boot).
# To go live: set STRIPE_MODE=live and restart (docker compose up -d).
STRIPE_MODE=test
STRIPE_LIVE_SECRET_KEY=
STRIPE_LIVE_WEBHOOK_SECRET=
STRIPE_LIVE_CONNECT_WEBHOOK_SECRET=
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_TEST_CONNECT_WEBHOOK_SECRET=
# Leave these blank — they are set automatically from the pair STRIPE_MODE picks.
# (Only set them directly if you are NOT using STRIPE_MODE.)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# --- AWS creds for the API (S3 uploads + SES) and ECR pulls ---
# Dedicated least-privilege IAM user (Lightsail has no instance role).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1

# --- Runtime / URLs ---
# NODE_ENV must be `production`: it enables HSTS/HTTPS enforcement and makes the
# app HARD-FAIL at boot if WEB_BASE_URL or the Stripe webhook secret are missing.
NODE_ENV=production
WEB_BASE_URL=https://freespace.ie
PUBLIC_API_BASE_URL=https://api.freespace.ie

# --- Observability ---
# Optional, but if blank Sentry silently does nothing — set it so prod errors
# are actually reported. Get the DSN from the Sentry project settings.
SENTRY_DSN=
# Optional extra alert sink (Slack/Discord incoming-webhook URL).
ERROR_REPORT_WEBHOOK_URL=

# --- Stripe Connect (host payouts) ---
# The connect webhook secret is set via STRIPE_*_CONNECT_WEBHOOK_SECRET above.
STRIPE_CONNECT_ENABLED=false

# --- Email from-addresses (Resend/SMTP) ---
EMAIL_FROM=
EMAIL_FROM_SIGNUP=
EMAIL_FROM_BOOKINGS=
EMAIL_FROM_SUPPORT=
SMTP_FROM=
SUPPORT_EMAIL=

# --- SMS (AWS SNS) ---
# Exit the SNS SMS sandbox before launch or only verified numbers receive texts.
SNS_SENDER_ID=
SNS_SMS_TYPE=Transactional

# --- Maps / OAuth ---
GOOGLE_MAPS_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Misc ---
# Shared secret guarding the manual notification-processor trigger endpoint.
NOTIFICATION_PROCESS_SECRET=
# CSRF: defaults on in production. Comma-separated extra allowed origins.
CSRF_PROTECT=
CSRF_ALLOWED_ORIGINS=
