# Copy to `.env` on the Lightsail box and fill in. NEVER commit the real .env.
# Secret values come from Secrets Manager: freespace/api-iHluTi

# --- Image source (ECR) ---
ECR_REGISTRY=530726524685.dkr.ecr.eu-west-1.amazonaws.com
# Pin to the tags currently in prod (git SHAs). Bump on each deploy.
# `redeploy.sh` will auto-fill API_TAG from the current git commit on the box.
API_TAG=92f168ad1a692f4dd66b29b8980975311036934a
WEB_TAG=56b589edd97524e033c647f3386663097f4bc341

# --- API secrets (from freespace/api-iHluTi) ---
# Stripe mode:
#   live -> use Secrets Manager values
#   test -> use STRIPE_TEST_SECRET_KEY and STRIPE_TEST_WEBHOOK_SECRET
# Set STRIPE_MODE=test to keep bookings in Stripe test mode.
DATABASE_URL=postgres://USER:PASS@freespace-db.cv48ycesawhx.eu-west-1.rds.amazonaws.com:5432/DBNAME
JWT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# --- AWS creds for the API (S3 uploads + SES) and ECR pulls ---
# Dedicated least-privilege IAM user (Lightsail has no instance role).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
