# Hand-made backups of an env file carry the same live keys as the original.
# The named .env entries below don't cover ".env.dev.bak-preclaude" and the
# like, so one nearly got committed in the clear.
*.bak
*.bak-*
.env.*.bak*
apps/api/.env
.env.local
.env.development
.env.production
apps/mobile/.env
apps/mobile/.env.local
apps/mobile/.env.local.source
apps/mobile/.env.dev
apps/mobile/.env.qa
apps/mobile/.env.production
apps/api/.env
apps/api/.env.local
apps/api/.env.dev
apps/api/.env.qa
apps/api/.env.production
dist
