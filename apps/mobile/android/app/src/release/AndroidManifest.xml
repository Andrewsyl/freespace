<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
  <!--
    Release-only manifest overrides. These permissions are pulled in by tooling /
    dependency manifest merges but are not needed by the shipped app, and Google
    Play flags them (SYSTEM_ALERT_WINDOW especially). Removing them here keeps them
    available for debug/dev-client builds (redbox overlay, etc.) while stripping
    them from the Play release.
  -->
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" tools:node="remove"/>
  <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove"/>
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove"/>
</manifest>
