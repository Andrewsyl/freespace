{
  "expo": {
    "name": "FreeSpace",
    "slug": "carparking",
    "version": "0.1.0",
    "userInterfaceStyle": "light",
    "icon": "./assets/white/png/icon-1024-rounded.png",
    "scheme": [
      "carparking",
      "com.googleusercontent.apps.742052774291-32p3r3jcea4oge0uec8aqqe9chi2f79l",
      "com.googleusercontent.apps.742052774291-7ebm33putsqqjjb8h5kebok0214hp38h"
    ],
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#22c55e",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-freespace.png",
          "resizeMode": "cover",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.andrewsyl.carparking"
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.742052774291-7ebm33putsqqjjb8h5kebok0214hp38h"
        }
      ]
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "splash": {
      "image": "./assets/splash-freespace.png",
      "resizeMode": "cover",
      "backgroundColor": "#FFFFFF"
    },
    "android": {
      "userInterfaceStyle": "light",
      "package": "ie.freespace.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/white/png/icon-1024-rounded.png",
        "backgroundColor": "#FFFFFF"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "freespace.ie",
              "pathPrefix": "/verify-email"
            },
            {
              "scheme": "https",
              "host": "freespace.ie",
              "pathPrefix": "/reset-password"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "usesCleartextTraffic": true,
      "compileSdkVersion": 35,
      "targetSdkVersion": 35,
      "buildToolsVersion": "35.0.0",
      "notification": {
        "icon": "./assets/notification-icon.png",
        "color": "#22c55e"
      },
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyC1h1NFLFz7SPauw85Udh0O1CBlN5bqOek"
        }
      },
      "versionCode": 103
    },
    "androidStatusBar": {
      "translucent": true,
      "backgroundColor": "#ffffff",
      "barStyle": "dark-content"
    },
    "androidNavigationBar": {
      "backgroundColor": "#ffffff",
      "barStyle": "dark-content"
    },
    "ios": {
      "bundleIdentifier": "com.andrewsyl.carparking",
      "buildNumber": "21",
      "jsEngine": "jsc",
      "associatedDomains": [
        "applinks:freespace.ie"
      ],
      "config": {
        "googleMapsApiKey": "AIzaSyC1h1NFLFz7SPauw85Udh0O1CBlN5bqOek"
      }
    },
    "extra": {
      "eas": {
        "projectId": "5eb5fe9d-294f-43ef-9c93-db911b93eb12"
      }
    },
    "owner": "andrewsyl"
  }
}
