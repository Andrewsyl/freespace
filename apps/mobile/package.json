{
  "name": "@carparking/mobile",
  "private": true,
  "version": "0.1.0",
  "main": "index.js",
  "scripts": {
    "dev:mobile": "./scripts/start-dev-client.sh dev",
    "dev:local": "./scripts/start-dev-client.sh local",
    "dev:dev": "./scripts/start-dev-client.sh dev",
    "dev:qa": "./scripts/start-dev-client.sh qa",
    "dev:prod": "./scripts/start-dev-client.sh production",
    "start": "expo start --localhost",
    "start:local": "./scripts/run-with-env.sh local expo start --localhost -c --scheme carparking-dev",
    "start:dev": "./scripts/run-with-env.sh dev expo start --localhost -c --scheme carparking-dev",
    "start:qa": "./scripts/run-with-env.sh qa expo start --localhost -c --scheme carparking",
    "start:prod": "./scripts/run-with-env.sh production expo start --localhost -c --scheme carparking",
    "android": "expo run:android",
    "android:local": "./scripts/run-with-env.sh local ./scripts/android-debug-install.sh ie.freespace.app.dev ie.freespace.app.MainActivity",
    "android:dev": "./scripts/run-with-env.sh dev ./scripts/android-debug-install.sh ie.freespace.app.dev ie.freespace.app.MainActivity",
    "android:qa": "./scripts/run-with-env.sh qa ./scripts/android-debug-install.sh ie.freespace.app.dev ie.freespace.app.MainActivity",
    "android:prod": "printf '%s\n' '[prod] Use npm run eas:prod for a real production-signed Android build. For local checks use npm run android:qa or, if you absolutely need the old debug-signed release APK, ALLOW_DEBUG_SIGNED_RELEASE=1 npm run android:prod:local-debug.' && exit 1",
    "android:prod:local-debug": "./scripts/run-with-env.sh production ./scripts/android-release-install.sh",
    "android:prod:apk": "./scripts/run-with-env.sh production ./scripts/android-release-install.sh",
    "android:prod:aab": "./scripts/run-with-env.sh production ./scripts/android-build-aab.sh",
    "android:prod:publish": "./scripts/run-with-env.sh production ./scripts/android-build-and-upload-play.sh",
    "ios": "expo run:ios",
    "ios:local": "./scripts/run-with-env.sh local expo run:ios",
    "ios:dev": "./scripts/run-with-env.sh dev expo run:ios",
    "ios:qa": "./scripts/run-with-env.sh qa expo run:ios",
    "ios:prod": "./scripts/run-with-env.sh production expo run:ios",
    "ios:prod:ipa": "./scripts/run-with-env.sh production ./scripts/ios-build-ipa.sh",
    "web": "expo start --web",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "maestro test .maestro",
    "test:e2e:guest": "maestro test .maestro/guest-smoke.yaml",
    "test:e2e:booking": "maestro test .maestro/driver-booking.yaml",
    "test:e2e:host": "maestro test .maestro/host-publish.yaml",
    "verify:lanes": "./scripts/check-lanes.sh",
    "eas:qa": "npx -y eas-cli@18.0.4 build --platform android --profile qa --clear-cache",
    "eas:prod": "npx -y eas-cli@18.0.4 build --platform android --profile production --clear-cache",
    "eas:prod:apk": "npx -y eas-cli@18.0.4 build --platform android --profile production-apk --clear-cache",
    "eas:prod:ios": "npx -y eas-cli@18.0.4 build --platform ios --profile production --clear-cache"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.4",
    "@eva-design/eva": "^2.2.0",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@miblanchard/react-native-slider": "^2.6.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.5.1",
    "@react-native-community/slider": "5.0.1",
    "@react-native-google-signin/google-signin": "^16.1.1",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-native-picker/picker": "2.11.4",
    "@react-native/virtualized-lists": "0.81.5",
    "@react-navigation/bottom-tabs": "^7.10.0",
    "@react-navigation/native": "^7.1.26",
    "@react-navigation/native-stack": "^7.9.0",
    "@sentry/react-native": "^8.5.0",
    "@stripe/stripe-react-native": "^0.57.2",
    "@ui-kitten/components": "^5.3.1",
    "expo": "~54.0.0",
    "expo-apple-authentication": "~8.0.8",
    "expo-auth-session": "^7.0.10",
    "expo-build-properties": "~0.13.1",
    "expo-crypto": "^15.0.8",
    "expo-dev-client": "~6.0.20",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-location": "~19.0.8",
    "expo-notifications": "^0.32.15",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "^15.0.10",
    "invariant": "^2.2.4",
    "lottie-react-native": "~7.3.1",
    "lucide-react-native": "^0.562.0",
    "posthog-react-native": "^4.49.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-date-picker": "^5.0.13",
    "react-native-figma-squircle": "^0.4.0",
    "react-native-image-zoom-viewer": "3.0.1",
    "react-native-maps": "^1.26.20",
    "react-native-paper": "^5.15.0",
    "react-native-reanimated": "^4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-view-shot": "4.0.3",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "^0.7.4",
    "simple-icons": "^16.12.0"
  },
  "devDependencies": {
    "@react-native/metro-config": "^0.80.3",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.7.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.16.0",
    "@typescript-eslint/parser": "^8.16.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-native": "^4.1.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.0",
    "react-test-renderer": "19.1.0",
    "typescript": "^5.6.3"
  }
}
