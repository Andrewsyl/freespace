PORT=4000
NODE_ENV=development

# App
WEB_BASE_URL=http://localhost:3000
JWT_SECRET=replace_with_long_random_secret
# Deep-link scheme for verify-email / reset-password links.
# Keep "carparking" until a build registering freespace:// is live in both stores.
APP_DEEP_LINK_SCHEME=carparking
DATABASE_URL=postgres://user:password@localhost:5432/freespace

# Stripe
STRIPE_SECRET_KEY=sk_test_replace
STRIPE_WEBHOOK_SECRET=whsec_replace
STRIPE_CONNECT_ENABLED=false

# Google
GOOGLE_MAPS_API_KEY=replace

# AWS S3 (optional, required for photo uploads)
AWS_REGION=eu-west-1
S3_BUCKET_NAME=replace_with_bucket_name
AWS_ACCESS_KEY_ID=replace_with_access_key_id
AWS_SECRET_ACCESS_KEY=replace_with_secret_access_key
AWS_SESSION_TOKEN=

# Optional security
ENFORCE_HTTPS=false
