PORT=8080
NODE_ENV=production

# App
WEB_BASE_URL=https://app-dev.example.com
JWT_SECRET=replace_with_long_random_secret
DATABASE_URL=postgresql://user:password@host:5432/carparking_dev?sslmode=no-verify

# Stripe
STRIPE_SECRET_KEY=sk_test_dev_replace
STRIPE_WEBHOOK_SECRET=whsec_dev_replace
STRIPE_CONNECT_ENABLED=false

# Google
GOOGLE_MAPS_API_KEY=replace

# AWS S3
AWS_REGION=eu-west-1
S3_BUCKET_NAME=freespace-dev-uploads
AWS_ACCESS_KEY_ID=replace_with_access_key_id
AWS_SECRET_ACCESS_KEY=replace_with_secret_access_key
AWS_SESSION_TOKEN=

# HTTPS redirect (enable only after TLS is configured end-to-end)
ENFORCE_HTTPS=false
