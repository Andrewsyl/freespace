PORT=8080
NODE_ENV=production

# App
WEB_BASE_URL=https://freespace-env.eu-west-1.elasticbeanstalk.com
JWT_SECRET=replace_with_long_random_secret
# Deep-link scheme for verify-email / reset-password links.
# Keep "carparking" until a build registering freespace:// is live in both stores.
APP_DEEP_LINK_SCHEME=carparking
DATABASE_URL=postgresql://user:password@host:5432/freespace?sslmode=no-verify

# Stripe
STRIPE_SECRET_KEY=sk_live_replace
STRIPE_PUBLISHABLE_KEY=pk_live_replace
STRIPE_WEBHOOK_SECRET=whsec_live_replace
STRIPE_CONNECT_ENABLED=false

# Google
GOOGLE_MAPS_API_KEY=replace

# AWS S3
AWS_REGION=eu-west-1
S3_BUCKET_NAME=replace_with_bucket_name
AWS_ACCESS_KEY_ID=replace_with_access_key_id
AWS_SECRET_ACCESS_KEY=replace_with_secret_access_key
AWS_SESSION_TOKEN=

# HTTPS redirect (enable only after TLS is configured end-to-end)
ENFORCE_HTTPS=false
