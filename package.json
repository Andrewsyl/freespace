{
  "name": "carparking",
  "private": true,
  "version": "0.1.0",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "apps/web",
    "apps/api",
    "apps/mobile"
  ],
  "scripts": {
    "check:env:local": "node scripts/check-env-sanity.mjs --mode=local",
    "check:env:production": "node scripts/check-env-sanity.mjs --mode=production",
    "check:firebase": "node scripts/check-firebase-config.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "dev:web": "npm --workspace apps/web run dev",
    "dev:web:lan": "adb reverse tcp:4000 tcp:4000 || true; LAN_IP=$(ifconfig en0 | awk '/inet /{print $2; exit}'); echo \"LAN_IP=$LAN_IP\"; NEXT_PUBLIC_API_BASE=\"http://$LAN_IP:4000\" npm --workspace apps/web run dev -- --hostname 0.0.0.0 --port 3000",
    "dev:api:lan": "LAN_IP=$(ifconfig en0 | awk '/inet /{print $2; exit}'); echo \"LAN_IP=$LAN_IP\"; WEB_BASE_URL=\"http://$LAN_IP:3000\" PORT=4000 npm --workspace apps/api run dev",
    "dev:api": "npm --workspace apps/api run dev",
    "dev:mobile": "adb reverse tcp:4000 tcp:4000 || true; npm --workspace apps/mobile run start",
    "test:mobile": "npm --workspace apps/mobile run test",
    "test:api": "npm --workspace apps/api run test",
    "test:web:e2e": "npm --workspace apps/web run test:e2e",
    "build:web": "npm --workspace apps/web run build",
    "lint:web": "npm --workspace apps/web run lint",
    "build:api": "npm --workspace apps/api run build",
    "lint:mobile": "npm --workspace apps/mobile run lint",
    "typecheck:mobile": "tsc -p apps/mobile/tsconfig.json --noEmit",
    "start:api": "npm --workspace apps/api run start",
    "smoke:post-deploy": "node scripts/post-deploy-smoke.mjs",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.18.0",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.2.6",
    "framer-motion": "^12.36.0",
    "recharts": "^3.8.0",
    "expo": "~54.0.33",
    "react": "19.1.0",
    "react-native": "0.81.5"
  }
}
